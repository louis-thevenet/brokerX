classDiagram
  title: Level 2 - Microservices Domain Architecture
  
  class APIGateway {
    <<gateway>>
    -config: Config
    -jwt_service: JwtService
    -user_client: UserClient
    -order_client: OrderClient
    -market_data_client: MarketDataClient
    -orchestrator_client: OrchestratorClient
    -mfa_service: MfaService
    +register()
    +login()
    +verifyLoginMfa()
    +logout()
    +getMe()
    +updateMe()
    +depositFunds()
    +createOrder()
    +getMyOrders()
    +getOrder()
    +updateOrder()
    +cancelOrder()
    +getMarketPrice()
    +getMarketPrices()
    +getMarketSymbols()
    +getMarketHistory()
  }
  
  class MfaService {
    <<service>>
    -provider: EmailOtpProvider
    +initiateChallenge()
    +verifyChallenge()
  }
  
  class TradeValidator {
    <<service>>
    -user_client: UserClient
    -market_data_client: MarketDataClient
    -config: ValidationConfig
    +validateTrade()
    +checkBalance()
    +validateSymbol()
    +validatePrice()
  }
  
  class UserService {
    <<microservice>>
    -user_service: UserService
    +createUser()
    +getUser()
    +getUserByEmail()
    +updateUser()
    +authenticateUser()
    +verifyUserEmail()
    +depositFunds()
    +getHoldings()
    +updateHoldings()
    +validateTrade()
    +healthCheck()
  }
  
  class OrderService {
    <<microservice>>
    -order_service: OrderService
    +createOrder()
    +getOrder()
    +getOrders()
    +updateOrder()
    +updateOrderExecution()
    +cancelOrder()
    +healthCheck()
  }
  
  class MarketDataService {
    <<microservice>>
    -market_data_service: MarketDataService
    -execution_simulator: ExecutionSimulator
    +getCurrentPrice()
    +getCurrentPrices()
    +getHistoricalPrices()
    +getAvailableSymbols()
    +initializeMarketData()
    +simulatePriceUpdate()
    +executeOrder()
    +healthCheck()
  }
  
  class OrderOrchestrator {
    <<microservice>>
    -order_queue: UnboundedSender
    -user_client: UserClient
    -order_client: OrderClient
    -market_data_client: MarketDataClient
    -api_gateway_client: ApiGatewayClient
    -trade_validator: TradeValidator
    -metrics: Metrics
    -concurrency_limiter: Semaphore
    +createOrder()
    +processOrderQueue()
    +validatePreTrade()
    +executeOrder()
    +updatePostTrade()
  }
  
  class UserRepository {
    <<repository>>
    -pool: PgPool
    +create()
    +get()
    +update()
    +findByEmail()
    +authenticate()
    +verifyEmail()
    +deposit()
    +getHoldings()
    +updateHoldings()
  }
  
  class OrderRepository {
    <<repository>>
    -pool: PgPool
    +create()
    +get()
    +findByUser()
    +update()
    +updateExecution()
    +cancel()
  }
  
  class MarketDataRepository {
    <<repository>>
    -pool: PgPool
    +getCurrentPrice()
    +getCurrentPrices()
    +getHistoricalPrices()
    +getSymbols()
    +initializeData()
    +updatePrice()
  }
  
  class User {
    <<entity>>
    +id: Uuid
    +email: String
    +password_hash: String
    +name: String
    +balance: Decimal
    +is_verified: bool
    +created_at: DateTime
    +updated_at: DateTime
  }
  
  class Holding {
    <<entity>>
    +id: Uuid
    +user_id: Uuid
    +symbol: String
    +quantity: i64
    +average_price: Decimal
    +created_at: DateTime
    +updated_at: DateTime
  }
  
  class Order {
    <<entity>>
    +id: Uuid
    +user_id: Uuid
    +symbol: String
    +quantity: i64
    +filled_quantity: i64
    +order_side: OrderSide
    +order_type: OrderType
    +limit_price: Option~Decimal~
    +status: OrderStatus
    +average_fill_price: Option~Decimal~
    +created_at: DateTime
    +updated_at: DateTime
  }
  
  class Stock {
    <<entity>>
    +id: Uuid
    +symbol: String
    +name: String
    +current_price: Decimal
    +last_updated: DateTime
  }
  
  %% API Gateway composition
  APIGateway *-- MfaService
  
  %% OrderOrchestrator composition
  OrderOrchestrator *-- TradeValidator
  
  %% API Gateway to services
  APIGateway ..> UserService: HTTP
  APIGateway ..> OrderService: HTTP
  APIGateway ..> MarketDataService: HTTP
  APIGateway ..> OrderOrchestrator: HTTP
  
  %% Order Orchestrator coordination
  OrderOrchestrator ..> UserService: Validate balance
  OrderOrchestrator ..> MarketDataService: Execute order
  OrderOrchestrator ..> OrderService: Update status
  OrderOrchestrator ..> UserService: Update holdings
  
  %% Service to repository
  UserService *-- UserRepository
  OrderService *-- OrderRepository
  MarketDataService *-- MarketDataRepository
  
  %% Repository to entity
  UserRepository --> User: manages
  UserRepository --> Holding: manages
  OrderRepository --> Order: manages
  MarketDataRepository --> Stock: manages
  
  @note right of APIGateway: Single entry point\nJWT authentication\nMFA orchestration\nRequest routing
  @note right of OrderOrchestrator: Async order processing\nPre-trade validation\nExecution coordination\nPost-trade settlement
  @note left of TradeValidator: Pre-trade validation\nBalance checks\nRisk limits\nPrice validation
  @note top of UserService: User domain\nAuthentication\nBalance management\nHoldings
  @note top of OrderService: Order domain\nOrder persistence\nStatus tracking
  @note bottom of MarketDataService: Market domain\nPrice simulation\nOrder execution