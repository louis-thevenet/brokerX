activityDiagram
title: Expérience Utilisateur BrokerX
start
:Utilisateur accède à l'application web;

if (session existante ?) then
  :Session déjà ouverte;
else
  :Proposer Connexion ou Inscription;

  switch (choix initial)
  case (Inscription)
    :Remplir formulaire inscription;
    :Créer nouveau compte;
    :Afficher confirmation inscription;
    :Lancer procédure de connexion;
  case (Connexion)
    :Lancer procédure de connexion;
  endswitch

  partition Authentification {
    :Soumettre identifiants;
    :Vérifier code OTP;
    if (authentification réussie ?) then
      :Ouvrir session utilisateur;
    else
      :Afficher erreur accès refusé;
      stop
    endif
  }
endif

partition TableauDeBord {
    :Afficher tableau de bord;
    note right: Solde, ordres, portfolio, données marché

  switch (choix utilisateur)
  case (Approvisionnement)
    :Saisir montant à déposer;
    :Valider et créditer portefeuille;
    :Confirmer dépôt;
    
  case (Modifier profil)
    :Modifier informations profil;
    :Enregistrer modifications;
    
  case (Consultation marché)
    :Afficher cotations temps réel;
    
  case (Passer un ordre)
    :Remplir formulaire ordre;
    :Soumettre ordre;
    :Le système traite l'ordre;
    if (ordre valide ?) then
      :Débiter/Créditer utilisateur;
      :Mettre à jour portfolio;
      :Passer l'ordre en traité;
    else
      :Passer l'ordre en rejeté;
    endif
    
  case (Afficher ordres)
    :Afficher historique ordres;
  endswitch
}

:Continuer navigation;
end

