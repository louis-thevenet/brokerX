ket data service unavailable"}}}},"/v1/market/prices/{symbol}/history":{"get":{"tags":["market"],"summary":"Get historical prices for a symbol","description":"Returns historical price data for charting and analysis.","operationId":"get_market_history","parameters":[{"name":"symbol","in":"path","description":"Stock symbol (e.g., AAPL)","required":true,"schema":{"type":"string"}},{"name":"limit","in":"query","description":"Maximum number of historical records (default: 100)","required":false,"schema":{"type":"integer","format":"int64"}}],"responses":{"200":{"description":"Historical price data"},"404":{"description":"Symbol not found"},"503":{"description":"Market data service unavailable"}}}},"/v1/market/symbols":{"get":{"tags":["market"],"summary":"Get list of available trading symbols","description":"Returns all symbols available for trading.\nThis endpoint is public and does not require authentication.","operationId":"get_market_symbols","responses":{"200":{"description":"List of available symbols"},"503":{"description":"Market data service unavailable"}}}},"/v1/me":{"get":{"tags":["user"],"summary":"Get current user profile","operationId":"get_me","responses":{"200":{"description":"User profile","content":{"application/json":{"schema":{"$ref":"#/components/schemas/UserResponse"}}}},"401":{"description":"Unauthorized"},"404":{"description":"User not found"}},"security":[{"bearer_auth":[]}]},"put":{"tags":["user"],"summary":"Update current user profile","operationId":"update_me","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/UpdateUserRequest"}}},"required":true},"responses":{"200":{"description":"User updated successfully","content":{"application/json":{"schema":{"$ref":"#/components/schemas/UserResponse"}}}},"401":{"description":"Unauthorized"},"404":{"description":"User not found"}},"security":[{"bearer_auth":[]}]}},"/v1/me/deposit":{"post":{"tags":["user"],"summary":"Deposit funds to user account","operationId":"deposit_fun