classDiagram
  title: Level 2 - Microservices Domain Architecture
  
  class APIGateway {
    <<orchestrator>>
    -config: GatewayConfig
    -jwt_service: JwtService
    -user_client: UserServiceClient
    -order_client: OrderServiceClient
    -market_data_client: MarketDataClient
    -market_data_execution_client: MarketDataExecutionClient
    -mfa_service: MfaServiceClient
    -trade_validator: TradeValidator
    +register()
    +login()
    +verifyLoginMfa()
    +createOrder()
    +getMyOrders()
    +getOrder()
    +updateOrder()
    +cancelOrder()
    +getMe()
    +depositFunds()
    +getMarketPrice()
    +getMarketPrices()
  }
  
  class TradeValidator {
    <<orchestration_service>>
    -user_client: UserServiceClient
    -market_data_client: MarketDataClient
    -config: PreTradeConfig
    +validateTrade()
    +checkBuyingPower()
    +validatePriceBands()
    +checkPositionLimits()
    +validateSymbol()
    +checkConcentrationLimits()
  }
  
  class UserService {
    <<microservice>>
    -user_repo: UserRepo
    -mfa_client: MfaClient
    +createUser()
    +getUser()
    +getUserByEmail()
    +authenticateUser()
    +verifyEmail()
    +updateUser()
    +depositFunds()
    +withdrawFunds()
    +getHoldings()
    +updateHoldings()
    +healthCheck()
  }
  
  class OrderService {
    <<microservice>>
    -order_repo: OrderRepo
    +createOrder()
    +getOrder()
    +getUserOrders()
    +updateOrder()
    +updateOrderExecution()
    +cancelOrder()
    +healthCheck()
  }
  
  class MarketDataService {
    <<microservice>>
    -market_repo: MarketDataRepo
    -price_engine: PriceEngine
    +getCurrentPrice()
    +getCurrentPrices()
    +getAllPrices()
    +getHistoricalPrices()
    +getAvailableSymbols()
    +executeOrder()
    +simulatePriceUpdate()
    +healthCheck()
  }
  
  class MFAAdapter {
    <<microservice>>
    -challenge_store: ChallengeStore
    -email_client: EmailClient
    +initiateChallenge()
    +initiateChallengeNoEmail()
    +verifyChallenge()
    +verifyChallengeBypass()
    +sendEmail()
    +healthCheck()
  }
  
  class UserRepo {
    <<repository>>
    -db_pool: Pool~UserDB~
    +create()
    +get()
    +update()
    +findByEmail()
    +authenticate()
  }
  
  class OrderRepo {
    <<repository>>
    -db_pool: Pool~OrderDB~
    +create()
    +get()
    +update()
    +findByUserId()
  }
  
  class MarketDataRepo {
    <<repository>>
    -db_pool: Pool~MarketDataDB~
    +getCurrentPrice()
    +getHistoricalPrices()
    +updatePrice()
    +getAllSymbols()
  }
  
  class User {
    <<entity>>
    +id: UserId
    +email: String
    +name: String
    +balance: f64
    +is_verified: bool
    +portfolio: Portfolio
  }
  
  class Order {
    <<entity>>
    +id: OrderId
    +client_id: UserId
    +symbol: String
    +quantity: u64
    +filled_quantity: u64
    +order_side: OrderSide
    +order_type: OrderType
    +status: OrderStatus
    +price: Option~f64~
    +average_price: Option~f64~
    +created_at: DateTime
  }
  
  class Portfolio {
    <<value_object>>
    +positions: Vec~Position~
    +calculateValue()
    +canAfford()
    +hasPosition()
  }
  
  class Position {
    <<value_object>>
    +symbol: String
    +quantity: u64
    +avg_price: f64
  }
  
  class ValidationResult {
    <<value_object>>
    +valid: bool
    +errors: Vec~ValidationError~
    +warnings: Vec~String~
  }
  
  class ExecutionResult {
    <<value_object>>
    +status: ExecutionStatus
    +filled_quantity: u64
    +average_price: Option~f64~
  }
  
  %% API Gateway composition and orchestration
  APIGateway *-- TradeValidator
  APIGateway ..> UserService: HTTP user operations
  APIGateway ..> OrderService: HTTP order management
  APIGateway ..> MarketDataService: HTTP price queries & execution
  APIGateway ..> MFAAdapter: HTTP MFA operations
  
  %% Trade Validator orchestration (pre-trade checks)
  TradeValidator ..> UserService: validate buying power
  TradeValidator ..> MarketDataService: validate symbol & price
  TradeValidator ..> ValidationResult: returns
  
  %% Service internal structure
  UserService *-- UserRepo
  OrderService *-- OrderRepo
  MarketDataService *-- MarketDataRepo
  
  %% Inter-service communication
  UserService ..> MFAAdapter: HTTP MFA requests
  
  %% Repository to Entity relationships
  UserRepo --> User: manages
  OrderRepo --> Order: manages
  User *-- Portfolio
  Portfolio *-- Position
  
  %% Order execution flow
  MarketDataService ..> ExecutionResult: returns
  
  %% Notes
  @note right of APIGateway: Central orchestrator\nHandles authentication JWT\nCoordinates order lifecycle\n1. Pre-trade validation\n2. Order creation\n3. Market execution\n4. Holdings update\nStateless service
  @note left of TradeValidator: Pre-trade validation logic\nChecks\n- User verification status\n- Buying power & balance\n- Position limits\n- Symbol validity\n- Price bands & tick size\nOrchestrates UserService + MarketDataService
  @note top of UserService: User domain owner\nManages users, portfolio, balance\nVerifies email via MFA\nIndependent deployment
  @note top of OrderService: Order domain owner\nManages order lifecycle\nStores order state\nIndependent deployment
  @note bottom of MarketDataService: Market data domain owner\nPrice simulation engine\nOrder execution logic\nOHLCV data management