# Order Service Environment Configuration
# Copy this file to .env when deploying order-service independently

# === Database Configuration ===
# Primary: Use ORDER_DATABASE_URL
ORDER_DATABASE_URL=postgresql://brokerx_user:password123@localhost:5433/brokerx_orders
# Fallback: If ORDER_DATABASE_URL is not set, DATABASE_URL will be used
# DATABASE_URL=postgresql://brokerx_user:password123@localhost:5433/brokerx_orders

# === Service Configuration ===
ORDER_SERVICE_PORT=3002
ORDER_SERVICE_HOST=0.0.0.0
