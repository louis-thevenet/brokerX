classDiagram
  title: Level 2 - Domain Architecture
  
  class UserManagement {
    <<bounded_context>>
    +User Registration & Authentication
    +Profile (firstname, surname)
    +Account Balance Management  
    +Portfolio Holdings
    +Email Verification & MFA
    +Subscription Management
  }
  
  class OrderManagement {
    <<bounded_context>>
    +Order Creation & Lifecycle
    +Order Status Tracking
    +Trade Validation
    +Buy/Sell Operations
    +Market/Limit Orders
  }
  
  class MarketData {
    <<bounded_context>>
    +Market Price Management
    +OHLCV Data (Open/High/Low/Close/Volume)
    +Price Simulation & Updates
    +Symbol Information
    +Historical Price Data
  }
  
  class EventStore {
    <<bounded_context>>
    +Order Event Sourcing
    +Saga State Management
    +Outbox Pattern
    +Event Publishing & Streaming
    +Correlation & Causation Tracking
  }
  
  class NotificationSystem {
    <<bounded_context>>
    +Order Execution Notifications
    +MFA/OTP Delivery
    +Market Data Reports
    +System Notifications
    +Multi-channel Delivery
  }
  
  class User {
    <<aggregate_root>>
    +UserId (Uuid)
    +email, firstname, surname
    +password_hash
    +balance (f64)
    +is_verified (bool)
    +holdings (HashMap<String, Holding>)
    +created_at
  }
  
  class Order {
    <<aggregate_root>>
    +OrderId (Uuid)
    +client_id (UserId)
    +symbol, quantity
    +OrderSide (Buy/Sell)
    +OrderType (Market/Limit)
    +OrderStatus (Pending/Filled/Rejected/Cancelled)
    +date
  }
  
  class MarketPrice {
    <<aggregate_root>>
    +id (Uuid)
    +symbol
    +price, open, high, low
    +volume (i64)
    +timestamp
  }
  
  class OrderEvent {
    <<aggregate_root>>
    +event_id (Uuid)
    +order_id, user_id
    +OrderEventType (ORDER_CREATED/ORDER_FILLED/etc)
    +correlation_id, causation_id
    +occurred_at
    +metadata (JsonB)
  }
  
  class NotificationType {
    <<aggregate_root>>
    +OrderExecution (order details)
    +Mfa (challenge_id, code)
    +MarketData (symbols, holdings)
    +System (title, message, priority)
  }
  
  %% Domain to Aggregate relationships
  UserManagement *-- User
  OrderManagement *-- Order
  MarketData *-- MarketPrice
  EventStore *-- OrderEvent
  NotificationSystem *-- NotificationType
  
  %% Cross-domain dependencies
  OrderManagement --> UserManagement: Validates balance & holdings
  OrderManagement --> MarketData: Gets prices & executes trades
  OrderManagement --> EventStore: Publishes order lifecycle events
  
  UserManagement --> EventStore: Publishes user events
  MarketData --> EventStore: Publishes price update events
  
  EventStore --> NotificationSystem: Triggers order notifications
  OrderManagement --> NotificationSystem: Order execution alerts
  UserManagement --> NotificationSystem: MFA & account notifications
  
  %% Entity relationships
  User --> Order: places orders
  Order --> MarketPrice: references symbol prices
  OrderEvent --> Order: tracks order lifecycle
  OrderEvent --> User: belongs to user
  
  @note right of UserManagement: User lifecycle & authentication\nBalance & holdings management\nSubscription preferences
  @note right of OrderManagement: Order creation & status tracking\nBuy/Sell operations\nTrade validation
  @note right of MarketData: OHLCV price data\nMarket simulation\nSymbol management
  @note left of EventStore: Event sourcing pattern\nSaga orchestration\nOutbox & correlation
  @note left of NotificationSystem: Multi-type notifications\nOrder/MFA/Market alerts\nEmail delivery