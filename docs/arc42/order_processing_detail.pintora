sequenceDiagram
  title: Order Processing Workflow (API Gateway Orchestrator, Detailed)

  participant User as Web Browser
  participant APIGateway as API Gateway
  participant TradeValidator as PreTradeValidator
  participant OrderService as Order Service
  participant MarketDataService as Market Data Service
  participant UserService as User Service

  %% Initial Order Submission
  User->>APIGateway: POST /v1/orders (JSON, JWT)
  APIGateway->>APIGateway: Extract JWT, validate authentication
  APIGateway->>APIGateway: Validate order request (fields, types, business rules)

  %% Pre-trade Validation
  APIGateway->>TradeValidator: validate_trade(user_id, symbol, quantity, side, type)
  TradeValidator->>UserService: getUser(user_id)
  UserService-->>TradeValidator: User (balance, holdings)
  TradeValidator->>TradeValidator: Check buying power, holdings, price bands, limits
  TradeValidator-->>APIGateway: ValidationResult (valid, errors, warnings)
  APIGateway->>APIGateway: If validation fails, return error to user

  %% Order Creation
  APIGateway->>OrderService: create_order(user_id, symbol, quantity, side, type)
  OrderService->>OrderService: Validate input, create Order (status=Pending), persist in DB
  OrderService-->>APIGateway: Order (id, status=Pending, details)

  %% Order Execution
  APIGateway->>MarketDataService: execute_order(order_id, symbol, side, type, quantity)
  MarketDataService->>MarketDataService: Simulate/execute order, determine fill status, price
  MarketDataService-->>APIGateway: ExecutionResult (status, filled_quantity, avg_price)

  %% Update Order Status
  APIGateway->>OrderService: update_order_execution(order_id, status, filled_quantity, avg_price)
  OrderService->>OrderService: Update order in DB, enforce state transitions
  OrderService-->>APIGateway: Updated Order

  %% Update User Account and Holdings
  alt Order Fully or Partially Filled
    APIGateway->>UserService: withdraw_funds(user_id, amount) or deposit_funds(user_id, amount)
    UserService->>UserService: Update user balance, persist in DB
    UserService-->>APIGateway: Success/Failure
    APIGateway->>UserService: update_holdings(user_id, symbol, quantity_change, exec_price)
    UserService->>UserService: Update holdings, persist in DB
    UserService-->>APIGateway: Success/Failure
  else Order Pending or Rejected
    note over APIGateway: No user update needed
  end

  APIGateway-->>User: HTTP 201 Created (Order details, status, execution info)

  %% Notes
  note over APIGateway,User: API Gateway orchestrates all steps, handles errors, and returns final result
  note over APIGateway: All service calls are synchronous HTTP requests, each service validates and persists its own data
