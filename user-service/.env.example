# User Service Environment Configuration
# Copy this file to .env when deploying user-service independently

# === Database Configuration ===
# Primary: Use USER_DATABASE_URL
USER_DATABASE_URL=postgresql://brokerx_user:password123@localhost:5432/brokerx_users
# Fallback: If USER_DATABASE_URL is not set, DATABASE_URL will be used
# DATABASE_URL=postgresql://brokerx_user:password123@localhost:5432/brokerx_users

# === Service Configuration ===
USER_SERVICE_PORT=3001
USER_SERVICE_HOST=0.0.0.0

# === SMTP Configuration (for Email OTP) ===
# Required for MFA functionality
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password-here
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_FROM_NAME=BrokerX Security

# Note: For Gmail, you need to:
# 1. Enable 2-factor authentication
# 2. Generate an app password
# 3. Use the app password instead of your regular password
