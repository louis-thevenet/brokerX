{"openapi":"3.1.0","info":{"title":"Market Data Service API","description":"Service for real-time market data, historical prices, and order execution simulation.","license":{"name":""},"version":"1.0.0"},"servers":[{"url":"http://localhost:3003","description":"Local development server"},{"url":"http://market-data-service:3003","description":"Docker service"}],"paths":{"/v1/execute":{"post":{"tags":["execution"],"summary":"Execute an order (called by API Gateway)\nSimulates order execution and returns result","operationId":"execute_order","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ExecuteOrderRequest"}}},"required":true},"responses":{"200":{"description":"Order executed successfully","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ExecuteOrderResponse"}}}},"400":{"description":"Invalid request"},"404":{"description":"Symbol not found"},"422":{"description":"Order rejected","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ExecuteOrderResponse"}}}}}}},"/v1/health":{"get":{"tags":["health"],"summary":"Health check endpoint\nReturns the service status and version information","operationId":"health_check","responses":{"200":{"description":"Service is healthy","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HealthResponse"}}}}}}},"/v1/initialize":{"post":{"tags":["admin"],"summary":"Initialize market data with predefined symbols\nCreates initial price data for common symbols if they don't exist","operationId":"initialize_market_data","responses":{"200":{"description":"Market data initialized","content":{"application/json":{"schema":{"$ref":"#/components/schemas/InitializeResponse"}}}}}}},"/v1/prices":{"get":{"tags":["prices"],"summary":"Get current prices for multiple symbols\nQuery parameter: symbols=AAPL,GOOGL,MSFT","operationId":"get_current_prices","parameters":[{"name":"symbols","in":"query","description":"Comma-separated list of symbols","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Current prices for requested symbols","content":{"application/json":{"schema":{"$ref":"#/components/schemas/MarketPricesResponse"}}}}}}},"/v1/prices/{symbol}":{"get":{"tags":["prices"],"summary":"Get current price for a specific symbol\nReturns the latest market price data for the requested symbol","operationId":"get_current_price","parameters":[{"name":"symbol","in":"path","description":"Asset symbol (e.g., AAPL, GOOGL)","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Current price data","content":{"application/json":{"schema":{"$ref":"#/components/schemas/MarketPriceResponse"}}}},"404":{"description":"Symbol not found"}}}},"/v1/prices/{symbol}/history":{"get":{"tags":["prices"],"summary":"Get historical prices for a symbol\nSupports optional date range filtering and result limiting","operationId":"get_historical_prices","parameters":[{"name":"symbol","in":"path","description":"Asset symbol","required":true,"schema":{"type":"string"}},{"name":"start_date","in":"query","description":"Start date (ISO 8601)","required":false,"schema":{"type":"string"}},{"name":"end_date","in":"query","description":"End date (ISO 8601)","required":false,"schema":{"type":"string"}},{"name":"limit","in":"query","description":"Maximum number of results (default: 100)","required":false,"schema":{"type":"integer","format":"int64"}}],"responses":{"200":{"description":"Historical price data","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HistoricalPricesResponse"}}}},"404":{"description":"Symbol not found"}}}},"/v1/simulate":{"post":{"tags":["admin"],"summary":"Simulate price update for all symbols\nGenerates new price data based on previous prices with realistic variations\nThis endpoint simulates market movement","operationId":"simulate_price_update","responses":{"200":{"description":"Prices updated","content":{"application/json":{"schema":{"$ref":"#/components/schemas/MessageResponse"}}}}}}},"/v1/symbols":{"get":{"tags":["symbols"],"summary":"Get list of all available symbols\nReturns all symbols that have market data available","operationId":"get_available_symbols","responses":{"200":{"description":"List of available symbols","content":{"application/json":{"schema":{"$ref":"#/components/schemas/SymbolsResponse"}}}}}}}},"components":{"schemas":{"ExecuteOrderRequest":{"type":"object","description":"Order execution request from API Gateway","required":["order_id","symbol","side","order_type","quantity"],"properties":{"order_id":{"type":"string","description":"Order ID from order service"},"order_type":{"$ref":"#/components/schemas/OrderType","description":"Order type (market or limit)"},"quantity":{"type":"integer","format":"int64","description":"Quantity of shares","example":100,"minimum":0},"side":{"$ref":"#/components/schemas/OrderSide","description":"Order side (buy or sell)"},"symbol":{"type":"string","description":"Asset symbol","example":"AAPL"}}},"ExecuteOrderResponse":{"type":"object","description":"Order execution response to API Gateway","required":["order_id","status","filled_quantity","timestamp"],"properties":{"average_price":{"type":["number","null"],"format":"double","description":"Average execution price (if filled)","example":175.5},"filled_quantity":{"type":"integer","format":"int64","description":"Number of shares filled","example":100,"minimum":0},"message":{"type":["string","null"],"description":"Additional information about execution"},"order_id":{"type":"string","description":"Order ID that was executed"},"status":{"$ref":"#/components/schemas/ExecutionStatus","description":"Execution status"},"timestamp":{"type":"string","description":"Execution timestamp"}}},"ExecutionStatus":{"type":"string","description":"Execution status enumeration","enum":["fully_filled","partially_filled","rejected"]},"HealthResponse":{"type":"object","required":["status","service","timestamp","version"],"properties":{"service":{"type":"string"},"status":{"type":"string"},"timestamp":{"type":"string"},"version":{"type":"string"}}},"HistoricalPricesQuery":{"type":"object","description":"Request to get historical prices for a symbol","properties":{"end_date":{"type":["string","null"],"format":"date-time","description":"End date for historical data"},"limit":{"type":"integer","format":"int64","description":"Limit the number of results"},"start_date":{"type":["string","null"],"format":"date-time","description":"Start date for historical data"}}},"HistoricalPricesResponse":{"type":"object","description":"Historical price data response","required":["symbol","prices","count"],"properties":{"count":{"type":"integer","minimum":0},"prices":{"type":"array","items":{"$ref":"#/components/schemas/MarketPriceResponse"}},"symbol":{"type":"string"}}},"InitializeResponse":{"type":"object","required":["message","symbols_created"],"properties":{"message":{"type":"string"},"symbols_created":{"type":"integer","minimum":0}}},"MarketPriceResponse":{"type":"object","description":"Response model for market price data (REST API)","required":["symbol","price","open","high","low","volume","timestamp"],"properties":{"high":{"type":"number","format":"double","description":"Highest price","example":176.8},"low":{"type":"number","format":"double","description":"Lowest price","example":173.9},"open":{"type":"number","format":"double","description":"Opening price","example":174.2},"price":{"type":"number","format":"double","description":"Current price","example":175.5},"symbol":{"type":"string","description":"Asset symbol","example":"AAPL"},"timestamp":{"type":"string","description":"Timestamp of the price data"},"volume":{"type":"integer","format":"int64","description":"Trading volume","example":1000000}}},"MarketPricesResponse":{"type":"object","description":"Response model for multiple market prices","required":["prices","count"],"properties":{"count":{"type":"integer","minimum":0},"prices":{"type":"array","items":{"$ref":"#/components/schemas/MarketPriceResponse"}}}},"MessageResponse":{"type":"object","required":["message"],"properties":{"message":{"type":"string"}}},"OrderSide":{"type":"string","description":"Order side enumeration","enum":["buy","sell"]},"OrderType":{"oneOf":[{"type":"object","required":["type"],"properties":{"type":{"type":"string","enum":["market"]}}},{"type":"object","required":["price","type"],"properties":{"price":{"type":"number","format":"double"},"type":{"type":"string","enum":["limit"]}}}],"description":"Order type enumeration"},"SymbolsResponse":{"type":"object","required":["symbols","count"],"properties":{"count":{"type":"integer","minimum":0},"symbols":{"type":"array","items":{"type":"string"}}}}}},"tags":[{"name":"prices","description":"Market price operations"},{"name":"symbols","description":"Symbol management"},{"name":"admin","description":"Administrative operations"},{"name":"execution","description":"Order execution simulation"},{"name":"health","description":"Health check operations"}]}