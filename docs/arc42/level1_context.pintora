classDiagram
  title: Level 1 - System Context Microservices

  class WebBrowser {
    <<actor>>
    +userInteractions()
    +loginRegister()
    +placeOrders()
    +viewPortfolio()
  }

  class APIGateway {
    <<system>>
    +requestRouting()
    +authValidation()
    +aggregation()
  }

  class UserService {
    <<service>>
    +createUser()
    +getUser()
    +updateUser()
    +getUserByEmail()
    +verifyUserEmail()
    +authenticateUser()
    +depositFunds()
    +withdrawFunds()
    +getHoldings()
    +updateHoldings()
    +validateTrade()
    +healthCheck()
  }

  class OrderService {
    <<service>>
    +createOrder()
    +getOrder()
    +getOrders()
    +updateOrder()
    +cancelOrder()
    +updateOrderExecution()
    +healthCheck()
  }

  class MarketDataService {
    <<service>>
    +getCurrentPrice()
    +getCurrentPrices()
    +getHistoricalPrices()
    +getAvailableSymbols()
    +initializeMarketData()
    +simulatePriceUpdate()
    +executeOrder()
    +healthCheck()
  }

  class MFAAdapter {
    <<service>>
    +initiateChallenge()
    +initiateChallengeNoEmail()
    +verifyChallenge()
    +verifyChallengeBypass()
    +getChallenge()
    +sendEmail()
    +healthCheck()
  }

  class UserDB {
    <<external>>
    +userAccounts()
    +portfolioData()
    +persistentStorage()
  }

  class OrderDB {
    <<external>>
    +ordersTransactions()
    +persistentStorage()
  }

  class MarketDataDB {
    <<external>>
    +marketPrices()
    +simulationState()
    +persistentStorage()
  }

  class SMTPEmailServer {
    <<external>>
    +emailDelivery()
    +mfaCodes()
    +registrationVerification()
    +accountNotifications()
  }

  %% User interactions
  WebBrowser --> APIGateway: HTTPS requests port 3000
  APIGateway --> WebBrowser: JSON responses

  %% API Gateway delegates to services
  APIGateway --> UserService: HTTP
  APIGateway --> OrderService: HTTP
  APIGateway --> MarketDataService: HTTP
  APIGateway --> MFAAdapter: HTTP

  %% Service infrastructure dependencies
  UserService --> UserDB: SQL queries
  OrderService --> OrderDB: SQL queries
  MarketDataService --> MarketDataDB: SQL queries
  UserService --> MFAAdapter: MFA requests
  MFAAdapter --> SMTPEmailServer: Email notifications

  %% Notes
  @note right of APIGateway: Rust microservices\nAxum and Tokio runtime\nService boundaries enforced\nStatic files via Tower-HTTP
  @note left of WebBrowser: HTML forms\nJWT authentication
  @note bottom of UserDB: Connection pooling\nAsync operations
  @note bottom of OrderDB: Connection pooling\nAsync operations
  @note bottom of MarketDataDB: Connection pooling\nAsync operations
  @note right of MFAAdapter: Handles MFA\nIntegrates with SMTP
