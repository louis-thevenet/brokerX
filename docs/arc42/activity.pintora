activityDiagram
title: Expérience Utilisateur BrokerX
start
:Utilisateur accède à l'application web;

if (session existante ?) then
  :Session déjà ouverte;
else
  :Proposer Connexion ou Inscription;

  switch (choix initial)
  case (Inscription)
    :Remplir formulaire inscription;
    :Créer nouveau compte;
    :Afficher confirmation inscription;
    :Lancer procédure de connexion;
  case (Connexion)
    :Lancer procédure de connexion;
  endswitch

  partition Authentification {
    :Soumettre identifiants;
    :Vérifier code OTP;
    if (authentification réussie ?) then
      :Ouvrir session utilisateur;
    else
      :Afficher erreur accès refusé;
      stop
    endif
  }
endif


