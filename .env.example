# BrokerX Environment Configuration
# Copy this file to .env and fill in your actual values
# This file is used for both local development and Docker deployments

# ========== LOGGING ==========
# Logging Level (error, warn, info, debug, trace)
RUST_LOG=info

# ========== DATABASE CONFIGURATION ==========
# User Database
USER_DATABASE_URL=postgres://brokerx_user:password123@localhost:5432/brokerx_users

# Order Database  
ORDER_DATABASE_URL=postgres://brokerx_user:password123@localhost:5433/brokerx_orders

# Market Data Database
MARKET_DATA_DATABASE_URL=postgres://brokerx_user:password123@localhost:5434/brokerx_market_data

# ========== SERVICE PORTS ==========
USER_SERVICE_PORT=3001
ORDER_SERVICE_PORT=3002
MARKET_DATA_SERVICE_PORT=3003
API_GATEWAY_PORT=8080

# ========== API GATEWAY CONFIGURATION ==========
API_GATEWAY_ADDRESS=0.0.0.0:8080
USER_SERVICE_URL=http://localhost:3001
ORDER_SERVICE_URL=http://localhost:3002
MARKET_DATA_SERVICE_URL=http://localhost:3003

# JWT Configuration
JWT_SECRET=change-me-in-production-please-use-a-long-random-string
JWT_EXPIRY_HOURS=24

# CORS Configuration (comma-separated list)
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000

# ========== SMTP CONFIGURATION ==========
# SMTP Server Settings (for email notifications and OTP)
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password-here
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME=BrokerX Security
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# Note: For Gmail, you need to:
# 1. Enable 2-factor authentication
# 2. Generate an app password specifically for this application
# 3. Use the app password instead of your regular password

# ========== WEBAPP ==========
WEBAPP_PORT=8000

# ========== MONITORING ==========
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin123

# ========== OPTIONAL TOOLS ==========
PGADMIN_PORT=5050
PGADMIN_EMAIL=admin@brokerx.local
PGADMIN_PASSWORD=admin123
