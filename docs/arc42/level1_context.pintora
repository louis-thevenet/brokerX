classDiagram
  title: Level 1 - System Context
  
  class User {
    <<actor>>
    +Access via browser
  }
  
  class WebApp {
    <<frontend>>
    +HTML/JavaScript interface
    +Authentication forms
    +Trading dashboard
    +Market data display
  }
  
  class APIGateway {
    <<gateway>>
    +JWT authentication
    +Request routing
    +CORS handling
    +MFA orchestration
  }
  
  class UserService {
    <<microservice>>
    +User CRUD
    +Authentication
    +Portfolio balance
    +Holdings management
    +Email verification
  }
  
  class OrderService {
    <<microservice>>
    +Order CRUD
    +Order persistence
    +Status tracking
    +Order history
    +Pagination
  }
  
  class MarketDataService {
    <<microservice>>
    +Current prices
    +Historical prices
    +Symbol management
    +Price simulation
    +Order execution simulation
  }
  
  class EventStoreService {
    <<microservice>>
    +Event sourcing
    +Saga choreography
    +Order lifecycle tracking
    +Event publishing
    +Outbox pattern
    +Transactional events
  }
  
  class NotificationService {
    <<microservice>>
    +Email notifications
    +Event consumption
    +User notifications
    +SMTP integration
    +Async notification processing
  }
  
  class MFAAdapter {
    <<library>>
    +OTP generation
    +Code verification
    +Challenge storage
    +Email sending
  }
  
  class Redis {
    <<event_streaming>>
    +Event pub/sub
    +Inter-service messaging
    +Event distribution
    +Cache layer
  }
  
  class UserDB {
    <<PostgreSQL>>
    +users table
    +holdings table
  }
  
  class OrderDB {
    <<PostgreSQL>>
    +orders table
  }
  
  class MarketDataDB {
    <<PostgreSQL>>
    +stocks table
    +prices table
  }
  
  class EventStoreDB {
    <<PostgreSQL>>
    +order_events table
    +saga_state table
    +outbox_messages table
    +event_checkpoints table
  }
  
  class EmailServer {
    <<external>>
    +SMTP relay
    +OTP delivery
    +Notification delivery
  }
  
  class Prometheus {
    <<monitoring>>
    +Metrics collection
    +Time series storage
    +Service monitoring
    +Performance metrics
  }
  
  class Grafana {
    <<visualization>>
    +Dashboard visualization
    +Alerting
    +Metrics analysis
    +Business intelligence
  }
  
  %% User flow
  User --> WebApp: Browser access
  WebApp --> APIGateway: HTTPS REST API
  
  %% API Gateway as single entry point
  APIGateway --> UserService: User operations
  APIGateway --> OrderService: Order queries
  APIGateway --> MarketDataService: Market data
  APIGateway --> EventStoreService: Order creation events
  
  %% Event-driven coordination via Redis
  EventStoreService --> Redis: Publish events
  Redis --> UserService: Subscribe events
  Redis --> OrderService: Subscribe events
  Redis --> MarketDataService: Subscribe events
  Redis --> NotificationService: Subscribe events
  
  %% Services publish events back to EventStore
  UserService --> EventStoreService: Publish events
  OrderService --> EventStoreService: Publish events  
  MarketDataService --> EventStoreService: Publish events
  
  %% Database connections
  UserService --> UserDB: SQL queries
  OrderService --> OrderDB: SQL queries
  MarketDataService --> MarketDataDB: SQL queries
  EventStoreService --> EventStoreDB: Event persistence
  
  %% MFA integration
  APIGateway ..> MFAAdapter: Uses library
  MFAAdapter --> EmailServer: SMTP
  
  %% Notification service
  NotificationService --> EmailServer: Email delivery
  
  %% Monitoring infrastructure
  
  Grafana --> Prometheus: Query metrics
  
  @note right of WebApp: Port 8000\nStatic HTML/JS
  @note right of APIGateway: Port 8080\nAxum/Rust
  @note right of UserService: Port 3001\nAxum/Rust
  @note right of OrderService: Port 3002\nAxum/Rust
  @note right of MarketDataService: Port 3003\nAxum/Rust
  @note right of EventStoreService: Port 3005\nAxum/Rust\nEvent sourcing
  @note right of NotificationService: Port 3006\nAxum/Rust\nAsync notifications
  @note right of MFAAdapter: Embedded crate\nNo network port
  @note right of Redis: Port 6380\nEvent streaming
  @note right of Prometheus: Port 9090\nGet Metrics from all services
  @note right of Grafana: Port 3000\nDashboard UI
  @note bottom of UserDB: Port 5432
  @note bottom of OrderDB: Port 5433
  @note bottom of MarketDataDB: Port 5434
  @note bottom of EventStoreDB: Port 5435
