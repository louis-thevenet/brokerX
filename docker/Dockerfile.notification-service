# Build stage
FROM rust:1.88-slim AS builder

# Install build dependencies
RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Copy workspace files
COPY Cargo.toml Cargo.lock ./
COPY notification-service ./notification-service
COPY user-service ./user-service
COPY order-service ./order-service
COPY market-data-service ./market-data-service
COPY event-store-service ./event-store-service
COPY brokerx-events ./brokerx-events
COPY api_gateway ./api_gateway

# Build the notification service
RUN cargo build --release --bin notification-service

# Runtime stage
FROM debian:bookworm-slim

# Install runtime dependencies
RUN apt-get update && apt-get install -y \
    ca-certificates \
    libssl3 \
    libpq5 \
    && rm -rf /var/lib/apt/lists/*

# Create app user
RUN groupadd -r app && useradd -r -g app app

# Copy binary from builder stage
COPY --from=builder /app/target/release/notification-service /usr/local/bin/notification-service

# Set ownership and permissions
RUN chown app:app /usr/local/bin/notification-service

# Switch to app user
USER app

# Expose port (if needed for health checks)
EXPOSE 3006

# Set entrypoint
ENTRYPOINT ["notification-service"]
