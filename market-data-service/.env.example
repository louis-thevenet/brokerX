# Market Data Service Environment Configuration
# Copy this file to .env when deploying market-data-service independently

# === Database Configuration ===
# Primary: Use MARKET_DATA_DATABASE_URL
MARKET_DATA_DATABASE_URL=postgresql://brokerx_user:password123@localhost:5434/brokerx_market_data
# Fallback: If MARKET_DATA_DATABASE_URL is not set, DATABASE_URL will be used
# DATABASE_URL=postgresql://brokerx_user:password123@localhost:5434/brokerx_market_data

# === Service Configuration ===
MARKET_DATA_SERVICE_PORT=3003
MARKET_DATA_SERVICE_HOST=0.0.0.0
