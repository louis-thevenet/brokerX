classDiagram
  title: Level 1 - System Context
  
  class User {
    <<actor>>
    +Access via browser
  }
  
  class WebApp {
    <<frontend>>
    +HTML/JavaScript interface
    +Authentication forms
    +Trading dashboard
    +Market data display
  }
  
  class APIGateway {
    <<gateway>>
    +JWT authentication
    +Request routing
    +CORS handling
    +MFA orchestration
    +Trade validation
  }
  
  class UserService {
    <<microservice>>
    +User CRUD
    +Authentication
    +Portfolio balance
    +Holdings management
    +Email verification
  }
  
  class OrderService {
    <<microservice>>
    +Order CRUD
    +Order persistence
    +Status tracking
    +Order history
    +Pagination
  }
  
  class MarketDataService {
    <<microservice>>
    +Current prices
    +Historical prices
    +Symbol management
    +Price simulation
    +Order execution simulation
  }
  
  class OrderOrchestrator {
    <<microservice>>
    +Order acceptance queue
    +Pre-trade validation
    +Balance checks
    +Symbol validation
    +Order execution coordination
    +Post-trade settlement
    +Async processing
  }
  
  class MFAAdapter {
    <<library>>
    +OTP generation
    +Code verification
    +Challenge storage
    +Email sending
  }
  
  class UserDB {
    <<PostgreSQL>>
    +users table
    +holdings table
  }
  
  class OrderDB {
    <<PostgreSQL>>
    +orders table
  }
  
  class MarketDataDB {
    <<PostgreSQL>>
    +stocks table
    +prices table
  }
  
  class EmailServer {
    <<external>>
    +SMTP relay
    +OTP delivery
  }
  
  %% User flow
  User --> WebApp: Browser access
  WebApp --> APIGateway: HTTPS REST API
  
  %% API Gateway as single entry point
  APIGateway --> UserService: User operations
  APIGateway --> OrderService: Order queries
  APIGateway --> MarketDataService: Market data
  APIGateway --> OrderOrchestrator: Order creation
  
  %% Internal orchestration
  OrderOrchestrator --> UserService: Validate balance
  OrderOrchestrator --> MarketDataService: Execute order
  OrderOrchestrator --> OrderService: Update status
  OrderOrchestrator --> UserService: Update holdings
  
  %% Database connections
  UserService --> UserDB: SQL queries
  OrderService --> OrderDB: SQL queries
  MarketDataService --> MarketDataDB: SQL queries
  
  %% MFA integration
  APIGateway ..> MFAAdapter: Uses library
  MFAAdapter --> EmailServer: SMTP
  
  @note right of WebApp: Port 8000\nStatic HTML/JS
  @note right of APIGateway: Port 8080\nAxum/Rust
  @note right of UserService: Port 3001\nAxum/Rust
  @note right of OrderService: Port 3002\nAxum/Rust
  @note right of MarketDataService: Port 3003\nAxum/Rust
  @note right of OrderOrchestrator: Port 3004\nAxum/Rust\nAsync queue
  @note right of MFAAdapter: Embedded crate\nNo network port
  @note bottom of UserDB: Port 5432
  @note bottom of OrderDB: Port 5433
  @note bottom of MarketDataDB: Port 5434
