# Multi-stage build for API Gateway
FROM rust:1.88-slim as builder

# Install build dependencies
RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy workspace files (need all members for workspace to work)
COPY Cargo.toml Cargo.lock ./
COPY mfa_adapter ./mfa_adapter
COPY user-service ./user-service
COPY order-service ./order-service
COPY market-data-service ./market-data-service
COPY order-execution-orchestrator-service ./order-execution-orchestrator-service
COPY event-store-service ./event-store-service
COPY api_gateway ./api_gateway

# Build the application
RUN cargo build --release -p api_gateway

# Runtime stage
FROM debian:bookworm-slim

# Install runtime dependencies
RUN apt-get update && apt-get install -y \
    ca-certificates \
    libssl3 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy the binary from builder
COPY --from=builder /app/target/release/api_gateway /app/api_gateway

# Create non-root user
RUN useradd -m -u 1000 brokerx && chown -R brokerx:brokerx /app
USER brokerx

EXPOSE 8080

CMD ["/app/api_gateway"]
