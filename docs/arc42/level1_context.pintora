classDiagram
  title: Level 1 - System Context with Microservices
  
  class User {
    <<actor>>
    +Trades stocks
    +Manages portfolio
    +Views market data
  }
  
  class APIGateway {
    <<system>>
    +Routes requests
    +Validates authentication
  }
  
  class UserService {
    <<microservice>>
    +User management
    +Portfolio management
    +Authentication
  }
  
  class OrderService {
    <<microservice>>
    +Order creation
    +Order execution
    +Order tracking
  }
  
  class MarketDataService {
    <<microservice>>
    +Price data
    +Market simulation
    +Symbol information
  }
  
  class MFAAdapter {
    <<microservice>>
    +MFA challenges
    +Code verification
  }
  
  class UserDB {
    <<database>>
    +User accounts
    +Portfolio data
  }
  
  class OrderDB {
    <<database>>
    +Orders
    +Transactions
  }
  
  class MarketDataDB {
    <<database>>
    +Market prices
    +Simulation state
  }
  
  class EmailServer {
    <<external system>>
    +Sends MFA codes
    +Sends notifications
  }
  
  %% User interactions
  User --> APIGateway: HTTPS requests
  APIGateway --> User: JSON responses
  
  %% API Gateway to services
  APIGateway --> UserService: HTTP
  APIGateway --> OrderService: HTTP
  APIGateway --> MarketDataService: HTTP
  APIGateway --> MFAAdapter: HTTP
  
  %% Services to databases
  UserService --> UserDB: SQL
  OrderService --> OrderDB: SQL
  MarketDataService --> MarketDataDB: SQL
  
  %% Cross-service dependencies
  UserService --> MFAAdapter: MFA requests
  MFAAdapter --> EmailServer: SMTP
  
  @note right of APIGateway: Rust/Axum\nPort 3000
  @note bottom of UserDB: PostgreSQL
  @note bottom of OrderDB: PostgreSQL
  @note bottom of MarketDataDB: PostgreSQL
