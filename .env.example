# BrokerX Root Environment Configuration
# Copy this file to .env and fill in your actual values
# This file is used when running all services locally from the root directory

# === Database URLs ===
USER_DATABASE_URL=postgresql://brokerx_user:password123@localhost:5432/brokerx_users
ORDER_DATABASE_URL=postgresql://brokerx_user:password123@localhost:5433/brokerx_orders
MARKET_DATA_DATABASE_URL=postgresql://brokerx_user:password123@localhost:5434/brokerx_market_data

# === Service Ports ===
USER_SERVICE_PORT=3001
ORDER_SERVICE_PORT=3002
MARKET_DATA_SERVICE_PORT=3003
API_GATEWAY_PORT=8080

# === Service URLs (for inter-service communication) ===
# These are used by the API Gateway to communicate with backend services
USER_SERVICE_URL=http://localhost:3001
ORDER_SERVICE_URL=http://localhost:3002
MARKET_DATA_SERVICE_URL=http://localhost:3003

# === API Gateway Configuration ===
API_GATEWAY_ADDRESS=0.0.0.0:8080
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRY_HOURS=24

# === SMTP Configuration (for User Service Email OTP) ===
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password-here
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_FROM_NAME=BrokerX Security

# Note: For Gmail, you need to:
# 1. Enable 2-factor authentication
# 2. Generate an app password specifically for this application
# 3. Use the app password instead of your regular password
