# Build stage
FROM rust:1.88-slim AS builder

WORKDIR /app

# Install dependencies
RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy workspace files
COPY Cargo.toml Cargo.lock ./
COPY mfa_adapter ./mfa_adapter
COPY user-service ./user-service
COPY order-service ./order-service
COPY market-data-service ./market-data-service
COPY api_gateway ./api_gateway
COPY brokerx-events ./brokerx-events
COPY event-store-service ./event-store-service

# Build the application
RUN cargo build --release --bin event-store-service

# Runtime stage
FROM debian:bookworm-slim

WORKDIR /app

# Install runtime dependencies
RUN apt-get update && apt-get install -y \
    ca-certificates \
    libssl3 \
    && rm -rf /var/lib/apt/lists/*

# Copy the binary from builder
COPY --from=builder /app/target/release/event-store-service /usr/local/bin/event-store-service


# Set environment variables
ENV RUST_LOG=info
ENV EVENT_STORE_SERVICE_PORT=3005

# Expose ports
EXPOSE 3005

# Run the service
CMD ["event-store-service"]
