sequenceDiagram
  title: Order Processing Workflow with Async Orchestrator

  participant User as Web Browser
  participant APIGateway as API Gateway
  participant OrderService as Order Service
  participant Orchestrator as Order Orchestrator
  participant Queue as Order Queue
  participant Validator as Trade Validator
  participant MarketData as Market Data Service
  participant UserService as User Service

  %% PHASE 1: Order Acceptance via API Gateway
  User->>APIGateway: POST /v1/orders with JWT
  APIGateway->>APIGateway: Validate JWT authentication
  APIGateway->>APIGateway: Validate request fields

  APIGateway->>OrderService: create_order with status PENDING
  OrderService->>OrderService: Persist order in DB
  OrderService-->>APIGateway: Order with id and PENDING status

  APIGateway->>Orchestrator: POST /v1/orders with order_id
  Orchestrator->>Queue: Enqueue order for async processing
  Queue-->>Orchestrator: Queued successfully
  Orchestrator-->>APIGateway: 202 Accepted with order_id

  APIGateway-->>User: 202 Accepted - Order queued

  note over User,APIGateway: Synchronous phase complete - User can poll order status

  %% PHASE 2: Async Processing in Background
  note over Queue,UserService: Async processing with concurrency limits

  Queue->>Orchestrator: Dequeue order
  Orchestrator->>Orchestrator: Acquire concurrency permit

  %% PRE-TRADE VALIDATION
  Orchestrator->>Validator: validate_trade
  Validator->>UserService: get_user for balance and holdings
  UserService-->>Validator: User data
  Validator->>MarketData: get_price via API Gateway cache
  MarketData-->>Validator: Current price
  Validator->>Validator: Check balance, holdings, limits, price bands
  Validator-->>Orchestrator: ValidationResult

  alt Validation Failed
    Orchestrator->>OrderService: update_order_execution to REJECTED
    OrderService-->>Orchestrator: Updated
    note over Orchestrator: Stop processing - order rejected
  else Validation Passed
    %% ORDER EXECUTION
    Orchestrator->>MarketData: execute_order
    MarketData->>MarketData: Simulate market execution
    MarketData-->>Orchestrator: ExecutionResult with status and price

    Orchestrator->>OrderService: update_order_execution with results
    OrderService-->>Orchestrator: Updated order

    alt Order Filled
      %% POST-TRADE SETTLEMENT
      Orchestrator->>UserService: withdraw_funds for BUY or deposit_funds for SELL
      UserService->>UserService: Update balance in DB
      UserService-->>Orchestrator: Balance updated

      Orchestrator->>UserService: update_holdings with quantity change
      UserService->>UserService: Update holdings in DB
      UserService-->>Orchestrator: Holdings updated

      note over Orchestrator: Order completed successfully
    else Order Rejected
      note over Orchestrator: No settlement needed
    end
  end

  Orchestrator->>Orchestrator: Release concurrency permit
  Orchestrator->>Orchestrator: Record metrics

  note over Orchestrator: Processing complete - User can fetch updated order

  %% USER POLLING
  User->>APIGateway: GET /v1/orders/:id
  APIGateway->>OrderService: get_order
  OrderService-->>APIGateway: Order with final status
  APIGateway-->>User: Order details with FILLED/REJECTED status
