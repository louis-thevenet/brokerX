{
  "packages": {
    ".": {
      "release-type": "rust",
      "component": "brokerx"
    },
    "user-service": {
      "path": "user-service",
      "release-type": "rust",
      "component": "user-service"
    },
    "order-service": {
      "path": "order-service",
      "release-type": "rust",
      "component": "order-service"
    },
    "market-data-service": {
      "path": "market-data-service",
      "release-type": "rust",
      "component": "market-data-service"
    },
    "api_gateway": {
      "path": "api_gateway",
      "release-type": "rust",
      "component": "api-gateway"
    },
    "brokerx-events": {
      "path": "brokerx-events",
      "release-type": "rust",
      "component": "brokerx-events"
    }
  },
  "plugins": [
    {
      "type": "cargo-workspace",
      "merge": false
    },
    {
      "type": "linked-versions",
      "groupName": "brokerx",
      "components": [
        "brokerx",
        "user-service",
        "order-service",
        "market-data-service",
        "api-gateway",
        "brokerx-events"
      ]
    }
  ]
}
